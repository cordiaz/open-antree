# Copy to .env (never commit .env).

# docker-compose.yml
POSTGRES_USER=antree
POSTGRES_PASSWORD=antree
POSTGRES_DB=antree
POSTGRES_PORT=5432
REDIS_PORT=6379

# apps/api
API_PORT=4000
DATABASE_URL=postgres://antree:antree@localhost:5432/antree
REDIS_URL=redis://localhost:6379
SESSION_TTL_HOURS=12
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false

# WhatsApp notifications for customers (see apps/api/README.md).
# off: disabled, no number asked | log: print messages to the API log (development)
# fonnte: send via Fonnte | meta: send via WhatsApp Cloud API templates
WHATSAPP_DRIVER=off
# Send the "almost your turn" message when this many tickets or fewer are ahead.
WHATSAPP_NEAR_AHEAD=3
# Country code for numbers typed with a leading 0.
PHONE_COUNTRY_CODE=62
# FONNTE_TOKEN=
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_TEMPLATE_NEAR=antrean_dekat
# WHATSAPP_META_TEMPLATE_CALLED=antrean_dipanggil
# WHATSAPP_META_LANGUAGE=id

# apps/web (Next.js reads apps/web/.env.local or the environment, not this file)
# API_URL=http://localhost:4000
