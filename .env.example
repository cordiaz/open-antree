# Copy to .env (never commit .env).

# docker-compose.yml
POSTGRES_USER=antree
POSTGRES_PASSWORD=antree
POSTGRES_DB=antree
POSTGRES_PORT=5432
REDIS_PORT=6379

# apps/api
API_PORT=4000
DATABASE_URL=postgres://antree:antree@localhost:5432/antree
REDIS_URL=redis://localhost:6379

# apps/web (Next.js reads apps/web/.env.local or the environment, not this file)
# API_URL=http://localhost:4000
